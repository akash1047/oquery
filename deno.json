{
  "name": "@oquery/oquery",
  "version": "0.1.0",
  "exports": "./mod.ts",
  "tasks": {
    "dev": "deno run --watch mod.ts",
    "test": "deno test --allow-none",
    "test:coverage": "deno test --coverage=coverage --allow-none",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check mod.ts",
    "publish:dry": "deno publish --dry-run"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "include": ["src/", "tests/", "mod.ts"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "include": ["src/", "tests/", "mod.ts"]
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "publish": {
    "include": ["mod.ts", "src/", "README.md", "LICENSE", "deno.json"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}
